# ===== 필수 =====
APP_ENV=production
SECRET_KEY=여기에-아무도-모르는-긴-문자열-입력
ADMIN_EMAIL=admin@buryrich.co.kr
ADMIN_PASSWORD=관리자-비밀번호-8자이상
DATA_DIR=/data

# ===== 선택 (비워 두면 해당 기능은 무료 방식으로 동작하거나 꺼짐) =====
# Claude: AI 장면 인식 + 홍보 문구 (유료, 1편 약 50~150원)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# YouTube Data API v3: 참고 영상 조회수/좋아요 등 공식 데이터 (무료 할당량)
YOUTUBE_API_KEY=
# 텔레그램 봇: 운영자 스마트폰 알림 (무료)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 음성 인식 모델 (무료, 서버에서 실행): tiny / base / small. 서버 메모리 1GB 이하면 base 권장. 비우면 끔
WHISPER_MODEL=base

MAX_UPLOAD_MB=1024
RETENTION_DAYS=90
